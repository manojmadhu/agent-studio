{
  "_meta": {
    "source": "portal/src/api/mock/sampleData.ts + catalog.ts (INVOICE_SCHEMA, RECEIPT_SCHEMA) + runEngine.ts constants",
    "default_document_id": "doc_inv_sample"
  },
  "documents": [
    {
      "id": "doc_inv_sample",
      "filename": "INV-2026-0417.pdf",
      "mime_type": "application/pdf",
      "pages": 1,
      "kind": "inv",
      "doc_kind": "invoice"
    },
    {
      "id": "doc_rcp_sample",
      "filename": "receipt_0918.jpg",
      "mime_type": "image/jpeg",
      "pages": 1,
      "kind": "rcp",
      "doc_kind": "receipt"
    }
  ],
  "values": {
